  "narrative": {
    "northStar": "The Documentary Contact Sheet",
    "overview": "A quiet, contemporary portfolio gives real community photographs and clear professional context room to speak. Oversized, close-set typography establishes the person; rectangular photographic sequences and thin rules organize the evidence. White and charcoal appearances share the same hierarchy and geometry.\n\nThe visual voice is mature, direct, and community-minded. Preserve the accurate medical-student identity and supplied photographic material when extending the system.",
    "keyCharacteristics": [
      "One self-hosted variable sans-serif family.",
      "Cool blue emphasis against restrained neutral grounds.",
      "Flat, rule-separated sections and rectangular photographs.",
      "Persistent light, dark, and device appearance choices."
    ],
    "rules": [
      {
        "name": "The Paired Appearance Rule",
        "body": "Extend semantic theme variables together so the same component geometry and hierarchy survive both appearances.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal contrast and rules for section structure rather than adding decorative elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic light/dark pairs for new surfaces.",
      "Do keep photographs rectangular and offer the complete image in the viewer.",
      "Do preserve visible keyboard focus and reduced-motion behavior.",
      "Do use real supplied material and accurate student status."
    ],
    "donts": [
      "Don't introduce decorative shadows into the flat section hierarchy.",
      "Don't convert photographic sequences into rounded generic cards.",
      "Don't infer clinical qualifications, impact counts, or testimonials from visual presentation."
    ]
  }
